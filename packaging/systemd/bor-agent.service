[Unit]
Description=Bor Policy Management Agent
Documentation=https://github.com/VuteTech/Bor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bor-agent
Restart=on-failure
RestartSec=30
# Long-running enforcement steps (flatpak installs, package transactions) are
# cancelled through the agent's context on stop; give them time to wind down
# cleanly before systemd escalates to SIGKILL.
TimeoutStopSec=120
# Run the agent with an MCS category of its own on SELinux systems. The
# category changes nothing by itself: the agent stays in the unconfined
# service domain and MCS binds only container domains for file access. It
# lets an SELinux policy single the agent process out, for example a
# constraint that refuses signals from senders at a lower level, without a
# policy module per node. The leading "-" makes systemd ignore a failure to
# set the context (a policy without the type); the directive is ignored
# entirely where SELinux is disabled.
SELinuxContext=-system_u:system_r:unconfined_service_t:s0:c1023
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bor-agent

[Install]
WantedBy=multi-user.target
