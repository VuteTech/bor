[Unit]
Description=Bor Policy Management Agent
Documentation=https://github.com/VuteTech/Bor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bor-agent
Restart=on-failure
RestartSec=30
# Long-running enforcement steps (flatpak installs, package transactions) are
# cancelled through the agent's context on stop; give them time to wind down
# cleanly before systemd escalates to SIGKILL.
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bor-agent

[Install]
WantedBy=multi-user.target
