# Bor Agent Configuration
# Protect this file: chmod 0600 /etc/bor/config.yaml

server:
  # Server hostname or IP address (no port).
  address: "localhost"
  # Port for enrollment RPC and admin UI — no mandatory client certificate.
  # Agents connect here on first run to obtain their mTLS certificate.
  enrollment_port: 8443
  # Port for mTLS policy streaming and certificate renewal.
  # Requires a valid, non-revoked client certificate (RequireAndVerifyClientCert).
  policy_port: 8444
  # Skip server certificate verification during enrollment only.
  # Set to true when the server uses a self-signed certificate.
  # After enrollment, the CA cert is stored locally and used for verification.
  insecure_skip_verify: true

agent:
  # Unique client identifier (defaults to hostname if empty)
  client_id: ""

# Enrollment settings for mTLS bootstrap
enrollment:
  # Directory where the agent stores its certificate, key, and CA cert after enrollment
  data_dir: "/var/lib/bor/agent"
  # To enroll manually, run: bor-agent --token <TOKEN>
  # Generate a token from the Node Groups page in the Bor web UI.
  # Alternatively, enable Kerberos enrollment below for token-free enrollment.

# Kerberos token-free enrollment (optional, for domain-joined hosts).
#
# When enabled, the agent authenticates to the Bor server using the machine
# keytab (/etc/krb5.keytab) instead of a manually generated enrollment token.
# This works with FreeIPA and Active Directory (Samba AD) domain-joined hosts.
#
# Prerequisites:
#   - The host must be joined to the domain (ipa-client-install, realm join, etc.)
#   - The machine keytab must exist at keytab_file
#   - The Bor server must have Kerberos enrollment enabled (server.yaml kerberos.enabled)
#   - service_principal must match the Bor server's Kerberos service principal
#
# FreeIPA joined hosts: /etc/krb5.keytab is created automatically by ipa-client-install
# AD joined hosts:      /etc/krb5.keytab is created by realm join or adcli
#
#kerberos:
#  enabled: false
#  keytab_file: "/etc/krb5.keytab"
#  service_principal: "HTTP/bor.example.com@EXAMPLE.COM"
#  # kdc: hostname or IP of the Key Distribution Center (domain controller).
#  # When set, the agent builds its Kerberos config from this address and the
#  # realm in service_principal, bypassing /etc/krb5.conf entirely.
#  # Useful when /etc/krb5.conf is missing, incomplete, or uses syntax that
#  # the agent's Kerberos library does not support (e.g. on Fedora/RHEL).
#  # Example: "dc1.example.com" or "192.0.2.10"
#  kdc: ""
#  # machine_principal: the Kerberos principal for this machine's keytab entry.
#  # Default is "host/<hostname>" which is correct for FreeIPA-joined hosts.
#  # For AD / Samba AD hosts joined with realm(1) or adcli, the keytab usually
#  # contains "<HOSTNAME>$" (with dollar sign) or "host/<fqdn>@REALM".
#  # Run "klist -kte /etc/krb5.keytab" on the agent host to find the value.
#  machine_principal: ""

# Firefox policy output paths
firefox:
  # System Firefox (RPM/DEB package)
  policies_path: "/etc/firefox/policies/policies.json"
  # Flatpak Firefox — extension directory (auto-detected arch; leave empty to disable)
  # The agent writes here as root; Firefox Flatpak mounts it at /app/etc/firefox/ inside the sandbox.
  flatpak_policies_path: "/var/lib/flatpak/extension/org.mozilla.firefox.systemconfig/x86_64/stable/policies/policies.json"

# Chrome/Chromium policy directories
# The agent writes bor_managed.json into each configured directory.
# Set any path to "" to disable writing to that variant.
chrome:
  # Google Chrome (stable, beta, dev, unstable — all channels share this path)
  chrome_policies_path: "/etc/opt/chrome/policies/managed"
  # Chromium (upstream build: Arch Linux, self-built, etc.)
  chromium_policies_path: "/etc/chromium/policies/managed"
  # Chromium (Debian/Ubuntu deb package)
  chromium_browser_policies_path: "/etc/chromium-browser/policies/managed"
  # Flatpak Chromium (org.chromium.Chromium) — set empty to disable
  flatpak_chromium_policies_path: "/var/lib/flatpak/extension/org.chromium.Chromium.Extension.system-policies/x86_64/1/policies/managed"

# KDE Plasma (KConfig) policy enforcement.
# All values are optional; the defaults shown are used when the section is absent.
#kconfig:
#  # Directory for the managed KDE configuration files. The agent puts it
#  # first in XDG_CONFIG_DIRS through /etc/xdg/plasma-workspace/env/00-bor.sh
#  # (Plasma sessions) and /etc/profile.d/99-bor.sh (login shells).
#  config_path: "/etc/bor/xdg"
#  # Directory for generated data files (look-and-feel packages with the
#  # deployed wallpaper and panel layout, Plasma update scripts). The hook
#  # scripts put it first in XDG_DATA_DIRS.
#  data_path: "/etc/bor/share"
#  # Also mirror System Settings module restrictions into /etc/kde5rc.
#  # Plasma 5 and 6 read them from kdeglobals, so leave this off unless a
#  # very old KDE Frameworks release needs it.
#  write_kde5rc: false
#  # After each sync, read the written settings back with kreadconfig in a
#  # logged-in user's session and report settings the user overrides (only
#  # possible for non-enforced defaults) as non-compliant. Also checks that
#  # the running Plasma session has the managed directory in XDG_CONFIG_DIRS.
#  probe_effective: false
#  # Expose the config directory to Flatpak applications through a
#  # system-wide "flatpak override" while KDE policies apply, so sandboxed
#  # KDE applications (Okular, Kate, ... from Flathub) read the managed
#  # settings. Node-wide settings only; ignored when flatpak is not installed.
#  flatpak_override: true

# Flatpak policy enforcement (remotes and applications via the flatpak CLI).
# All values are optional; the defaults shown are used when the section is absent.
#flatpak:
#  # flatpak executable name or absolute path.
#  binary: "flatpak"
#  # Directory for the Bor-rendered remote definitions (*.flatpakrepo, *.filter, *.gpg).
#  # These files are tamper-protected by the agent.
#  state_dir: "/etc/bor/flatpak"
#  # Record of remotes Bor created or adopted, used to undo changes when a policy is unbound.
#  state_file: "/var/lib/bor/agent/flatpak-state.json"
#  # Optional HTTP(S) proxy for flatpak downloads, e.g. "http://proxy.example.com:3128".
#  proxy_url: ""

# Disk encryption (LUKS2) policy enforcement: inventory, recovery-key escrow,
# TPM2 and Tang/Clevis protectors. All values are optional; the defaults
# shown are used when the section is absent.
#disk_encryption:
#  # Rotation crash-recovery state (progress only - never holds keys).
#  state_file: "/var/lib/bor/agent/luks-state.json"
#  # One-time provisioning credentials placed by the installer
#  # (<luks-uuid>.key, mode 0600); consumed and wiped during adoption.
#  bootstrap_dir: "/etc/bor/luks-bootstrap"
#  # Root-only tmpfs work directory (Clevis TMPDIR, adopt lock).
#  run_dir: "/run/bor/luks"
#  # Tool binaries, resolved via PATH when not absolute.
#  cryptsetup: "cryptsetup"
#  cryptenroll: "systemd-cryptenroll"
#  clevis: "clevis"

# Services & timers (systemd) policy settings.
# The agent writes one drop-in per managed unit (<system_dir>/<unit>.d/90-bor.conf),
# records the original state of every unit it touches in state_path so the
# unit can be restored when it leaves every policy, and drives systemd over
# the D-Bus system bus.
#systemd:
#  system_dir: /etc/systemd/system
#  # Preset file (10-bor.preset) for policies that extend their enablement
#  # decisions to units installed later.
#  preset_dir: /etc/systemd/system-preset
#  # Scripts of Bor-deployed tasks (bor-<name>.service / .timer).
#  scripts_dir: /etc/bor/systemd
#  state_path: /var/lib/bor/agent/systemd-state.json
#  # How long to wait for a start, stop or restart job to finish.
#  job_timeout: 90s
#  # Re-assert unit states this often while Systemd policies apply (drift
#  # detection for states that are not files); 0 disables the ticker.
#  reconcile_interval: 10m
#  # React within seconds to a managed unit stopped, started, enabled or
#  # disabled by hand, through systemd's D-Bus signals. The ticker above
#  # remains the backstop when this is off.
#  watch_signals: true
#  # Deploy Bor tasks (scripts that run as root). With false, policies that
#  # carry tasks report an error for them and nothing is written.
#  allow_tasks: true
#  # systemd-analyze executable used to validate calendar expressions and
#  # the unit files of tasks.
#  analyze_binary: systemd-analyze
#  # Directories of the user-manager scope: units and tasks a policy marks
#  # "all users" are written here and enabled as "systemctl --global" does.
#  user_dir: /etc/systemd/user
#  user_preset_dir: /etc/systemd/user-preset
#  # Run the start, stop and restart actions requested from the node page
#  # of the console (holders of systemd:operate). With false the node
#  # answers every action with an error.
#  allow_actions: true

# SELinux policy settings.
# The agent sets the mode through selinuxfs and /etc/selinux/config,
# booleans with setsebool -P, writes Bor's CIL modules under modules_dir and
# installs them with semodule at module_priority, and records every original
# value in state_path so it can be restored when it leaves every policy.
#selinux:
#  config_path: /etc/selinux/config
#  modules_dir: /etc/bor/selinux
#  # semodule priority of Bor modules; keeps them apart from the
#  # distribution's (100) and the administrator's (400).
#  module_priority: 450
#  state_path: /var/lib/bor/agent/selinux-state.json
#  # Re-assert the mode, booleans and modules this often while SELinux
#  # policies apply; 0 disables the ticker.
#  reconcile_interval: 5m
#  # Let policies switch the node between enforcing and permissive.
#  allow_mode_change: true
#  # Install Bor CIL modules, permissive domains and file contexts.
#  allow_custom_modules: true
#  # Follow the audit log so a manual setenforce or setsebool is reconciled
#  # within seconds. The ticker above remains the backstop.
#  follow_audit: true
#  # Maximum run time of one semodule or setsebool call.
#  tool_timeout: 5m

# AppArmor policy settings.
# The agent sets profile modes through the disable/ and force-complain/
# links of profiles_dir, writes Bor profiles there (bor-<name>), local
# overrides into its local/ directory and the home directory tunable, and
# drives apparmor_parser.
#apparmor:
#  profiles_dir: /etc/apparmor.d
#  parser_binary: apparmor_parser
#  # sysctl.d file for the user namespace restriction switches.
#  sysctl_path: /etc/sysctl.d/zz-bor-apparmor.conf
#  state_path: /var/lib/bor/agent/apparmor-state.json
#  # Backups of vendor profile files whose mode flags a policy edited.
#  backup_dir: /var/lib/bor/agent/apparmor-backups
#  reconcile_interval: 5m
#  # Write Bor profiles and local overrides.
#  allow_custom_profiles: true
#  # Let policies strip the complain flag inside vendor profile files
#  # (package conffiles). Off by default.
#  allow_vendor_flag_edits: false
#  follow_audit: true
#  tool_timeout: 2m

# Shared settings of both mandatory access control types.
#mac:
#  # How often the inventory (status, booleans or profiles, denial summary)
#  # is re-sent while the agent is connected.
#  inventory_interval: 1h
#  # How far back the denial summary looks.
#  denial_window: 24h
#  # Read the audit records of the journal for the denial summary.
#  collect_denials: true
#  # Answer proposal requests (audit2allow, AppArmor rules from denials)
#  # from the node page of the console (holders of mac:operate).
#  allow_actions: true

# Software updates (Updates policy type). The agent configures the
# distribution's update engine, keeps its timer in step with the policy,
# decides reboots and reports the update state.
updates:
  engine: auto          # detected; force dnf-automatic, unattended-upgrades, os-update, transactional-update or rpm-ostree
  state_path: /var/lib/bor/agent/updates-state.json
  backup_dir: /var/lib/bor/agent/updates-backups
  reconcile_interval: 10m
  inventory_interval: 1h
  reboot_check_interval: 1m
  tool_timeout: 10m
  allow_install: true   # install the engine package when a policy asks
  allow_reboot: true    # let policies reboot the node

